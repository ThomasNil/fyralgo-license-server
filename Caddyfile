he97.fyrvest.com, license.fyralgo.com {
    reverse_proxy api:8000
}

# fyralgo-ingest (separate repo/compose project, joins this box's shared `edge` network).
# api.fyralgo.com is a CNAME to he97.fyrvest.com -- see fyralgo-ingest/docs/DESIGN.md.
api.fyralgo.com {
    reverse_proxy fyralgo-ingest:8080
}

# truefill-web (separate repo/compose project, joins this box's shared `edge` network).
# Temporary hostname until truefill.io is registered -- add it to this same block when it is.
truefill.fyralgo.com {
    reverse_proxy truefill-web:3000
}

fyralgo.com, www.fyralgo.com {
    reverse_proxy web:3000
}

fyralgo.fyrvest.com {
    redir https://fyralgo.com{uri} permanent
}

# sigill (regtech-reporting/site, separate repo/compose project, joins this box's
# shared `edge` network). sigill.report is also registered but redirects here —
# sigill.tech is canonical (site: in site/astro.config.mjs).
sigill.tech, www.sigill.tech {
    reverse_proxy sigill-site:4321
}
sigill.report {
    redir https://sigill.tech{uri} permanent
}

# The Sigill portal (regtech-reporting/deploy/docker-compose.portal.yml, same
# `edge` network). The SPA calls /v1 RELATIVELY -- there is no VITE_ base-url
# variable, vite only proxies in dev (ADR 0004). So the same origin must serve
# both the static files and the API, and that split happens here.
#
# `handle` and not `handle_path`: the API expects the /v1 prefix, and
# handle_path would strip it. Order matters -- the /v1 matcher must come first.
portal.sigill.tech {
    handle /v1/* {
        reverse_proxy portal-api:8000
    }
    handle {
        reverse_proxy portal-web:8080
    }
}

# Keycloak. Its own hostname because the portal is static files with no server
# behind them; Keycloak is a separate service. The URL must be reachable FROM
# THE BROWSER and match the token's `iss` claim exactly, which is why
# KC_HOSTNAME is set to this value in the compose file.
#
# Keycloak runs with KC_PROXY_HEADERS=xforwarded and trusts X-Forwarded-Proto
# from here; without it Keycloak builds http:// redirects and the browser
# blocks them as mixed content.
auth.sigill.tech {
    reverse_proxy portal-keycloak:8080
}

# chatwoot-fyrvest (separate repo/compose project, joins this box's shared `edge`
# network). Self-hosted support desk for Fyrvest AB's businesses -- Sigill first,
# further accounts later in the same installation, which is why the hostname is
# the only sigill.tech name here that is not the product itself.
#
# FRONTEND_URL in that repo's .env must match this hostname exactly. Chatwoot
# builds asset URLs, notification links and the widget script tag from it, so a
# mismatch produces a page that loads but is subtly broken rather than an error.
support.sigill.tech {
    reverse_proxy chatwoot:3000
}

# regtech-reporting mirror: EBA reference data (DPM database, taxonomy packages).
# Static files at C:\srv\frameworks on this box, volume-mounted read-only into this container
# (see docker-compose.yml). Served under /frameworks/ so reporting.fyrvest.com stays
# free for the reporting portal itself later. Immutable per release: a file is never
# replaced, a new version directory is added instead.
# Setup/consumers: regtech-reporting/docs/mirror.md
reporting.fyrvest.com {
    handle_path /frameworks/* {
        root * /srv/mirror
        file_server browse
        header Cache-Control "public, max-age=31536000, immutable"
    }
}

